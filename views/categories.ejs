<!DOCTYPE html>
<html lang="en">
  <%- include("partials/head") %>
  <body>
    <%- include("partials/nav") %>
    <main>
      <div class="categories-container">

        <div class="title">
          <h1>All Categories</h1>
          <a href="">Create New Category</a>
          <form action="/categories" method="POST">
            <input type="text" name="category_name" placeholder="Enter category name" required />
            <button type="submit">Add</button>
          </form>
          <%- include("partials/errors") %>
        </div>

        <div class="categories">
          <ul class="categories-list">
            <% for (let category of CATEGORIES) { %>
            <li class="category-card">
              <h2><%= category.category_name %></h2>
              <form action="/categories/<%= category.category_id %>/delete" method="POST">
                <button type="submit" class="btn-delete" onclick="return confirm('Are you sure you want to delete this category?')">Delete</button>
              </form>
            </li>
            <% } %>
          </ul>
        </div>
      </div>
    </main>
    <%- include("partials/footer") %>
  </body>
</html>