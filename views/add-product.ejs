<!DOCTYPE html>
<html lang="en">
  <%- include("partials/head") %>
  <body>
    <%- include("partials/nav") %>
    <main>
      <div class="add-product-container">
        <h1>Add A New Product</h1>
        <form action="/product/new" method="POST" enctype="multipart/form-data">

          <div class="form-group">
            <label for="product_name">Product Name: </label>
            <input type="text" class="form-input" id="product_name" name="product_name" value="<%- locals.LASTPARAMS?.product_name || '' %>" placeholder="Enter product name here" required/>
          </div>

          <div class="form-group">
            <label for="price">Price: </label>
            <input type="number" class="form-input" id="price" name="price" value="<%= locals.LASTPARAMS?.price || '' %>" placeholder="Enter price here" required/>
          </div>

          <div class="form-group">
            <label for="quantity">Quantity: </label>
            <input type="number" class="form-input" id="quantity" name="quantity" value="<%= locals.LASTPARAMS?.quantity || '' %>" placeholder="Enter quantity here" required/>
          </div>

          <div class="form-group">
            <label for="category_id">Choose a Category: </label>
            <select id="category_id" name="category_id" class="form-select" required>
              <% for (let category of CATEGORIES) {%>
                <% let isSelected = locals.LASTPARAMS?.category_id == category.category_id; %>
                <option value="<%= category.category_id %>" <%= isSelected ? "selected" : "" %>>
                  <%= category.category_name %>
                </option>
                <% } %>
            </select>
          </div>

          <div class="form-group">
            <label for="description">Description: </label>
            <textarea class="form-input" id="description" name="description" rows="4" cols="50" placeholder="Enter description here" required><%- locals.LASTPARAMS?.description || '' %></textarea>
          </div>

          <div class="form-group">
            <label for="product_image">Upload Image: </label>
            <input type="file" id="product_image" name="product_image" accept="image/*" required />
          </div>
          <button type="submit" class="add-product-btn">Add Product</button>
        </form>
      </div>
      <%- include("partials/errors") %>
    </main>
    <%- include("partials/footer") %>
  </body>
</html>