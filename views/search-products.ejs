<!DOCTYPE html>
<html lang="en">
  <%- include("partials/head") %>
  <body>
    <%- include("partials/nav") %>
    <main>
    <aside>
      <form action="/search" method="GET">
        <input type="hidden" name="productName" value="<%= locals.LASTPARAMS?.productName || "" %>" />
        <fieldset class="category filter">
          <legend>Category (multiple allowed) :</legend>
          <div>
          <% let isStrategyChecked = false;
              if (locals.LASTPARAMS?.category) {
                if (Array.isArray(LASTPARAMS.category)) {
                  isStrategyChecked = LASTPARAMS.category.includes('Strategy');
                  } else {
                    isStrategyChecked = LASTPARAMS.category === 'Strategy';
                    }
                  }
          %>
            <input type="checkbox" id="strategy" name="category" value="Strategy" <%= isStrategyChecked ? "checked" : "" %> />
            <label for="strategy">Strategy</label>
          </div>
          <div>
          <% let isPartyChecked = false;
              if (locals.LASTPARAMS?.category) {
                if (Array.isArray(LASTPARAMS.category)) {
                  isPartyChecked = LASTPARAMS.category.includes('Party & Social');
                  } else {
                    isPartyChecked = LASTPARAMS.category === 'Party & Social';
                    }
                  }
          %>
            <input type="checkbox" id="party & social" name="category" value="Party & Social" <%= isPartyChecked ? "checked" : "" %> />
            <label for="party & social">Party & Social</label>
          </div>
          <div>
          <% let isCooperativeChecked = false;
              if (locals.LASTPARAMS?.category) {
                if (Array.isArray(LASTPARAMS.category)) {
                  isCooperativeChecked = LASTPARAMS.category.includes('Cooperative');
                  } else {
                    isCooperativeChecked = LASTPARAMS.category === 'Cooperative';
                    }
                  }
          %>
            <input type="checkbox" id="cooperative" name="category" value="Cooperative" <%= isCooperativeChecked ? "checked" : "" %> />
            <label for="cooperative">Cooperative</label>
          </div>
          <div>
          <% let isFamilyChecked = false;
              if (locals.LASTPARAMS?.category) {
                if (Array.isArray(LASTPARAMS.category)) {
                  isFamilyChecked = LASTPARAMS.category.includes('Family & Kids');
                  } else {
                    isFamilyChecked = LASTPARAMS.category === 'Family & Kids';
                    }
                  }
          %>
            <input type="checkbox" id="family & kids" name="category" value="Family & Kids" <%= isFamilyChecked ? "checked" : "" %> />
            <label for="family & kids">Family & Kids</label>
          </div>
          <div>
          <% let isThematicChecked = false;
              if (locals.LASTPARAMS?.category) {
                if (Array.isArray(LASTPARAMS.category)) {
                  isThematicChecked = LASTPARAMS.category.includes('Thematic & Immersive');
                  } else {
                    isThematicChecked = LASTPARAMS.category === 'Thematic & Immersive';
                    }
                  }
          %>
            <input type="checkbox" id="thematic & immersive" name="category" value="Thematic & Immersive" <%= isThematicChecked ? "checked" : "" %> />
            <label for="thematic & immersive">Thematic & Immersive</label>
          </div>
        </fieldset>
        <fieldset>
          <legend>Sort By :</legend>
          <div>
            <input type="radio" id="price" name="sortBy" value="price"
            <%= locals.LASTPARAMS?.sortBy === "price" ? "checked" : "" %>
            >
            <label for="price">Price</label>
          </div>
          <div>
            <input type="radio" id="alpha" name="sortBy" value="alpha"
            <%= locals.LASTPARAMS?.sortBy === "alpha" ? "checked" : "" %>
            >
            <label for="alpha">Alphabetical</label>
          </div>
        </fieldset>
        <fieldset>
          <legend>Order By :</legend>
          <div>
            <input type="radio" id="asc" name="order" value="asc"
            <%= locals.LASTPARAMS?.order === "asc" ? "checked" : "" %>
            >
            <label for="asc">Ascending</label>
          </div>
          <div>
            <input type="radio" id="desc" name="order" value="desc"
            <%= locals.LASTPARAMS?.order === "desc" ? "checked" : "" %>
            >
            <label for="desc">Descending</label>
          </div>
        </fieldset>
        <button type="submit">Filter</button>
      </form>
    </aside>
    <div class="product-cards-container">
      <h1>Search Results</h1>
        <% for (let product of PRODUCTS) { %>
          <div class="product-card">
            <img src="<%= product.product_image_url %>" alt="<%= product.product_name %>"/>
            <h2><%= product.product_name %></h2>
            <p>$ <%= product.price %></p>
            <p>Stock: <%= product.quantity %></p>
            <p>Description: <%= product.description %> </p>
            <a href="/product/<%= product.product_id %>">Edit</a>
          </div>
        <% } %>
    </div>
    </main>
    <%- include("partials/footer") %>
  </body>
</html>